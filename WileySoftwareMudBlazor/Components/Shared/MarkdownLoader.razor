@* Reusable component to fetch and render Markdown from a URL. *@
@using System.Net.Http
@using Markdig
@inject HttpClient Http

@if (string.IsNullOrEmpty(Content))
{
    // Show a spinner while loading content.
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
}
else
{
    // Render the fetched content as HTML.
    <MudPaper Class="pa-4" Elevation="0">
        @((MarkupString)HtmlContent)
    </MudPaper>
}

@code {
    [Parameter]
    public string Url { get; set; }

    private string Content { get; set; }
    private string _lastUrl;

    private string HtmlContent => Markdown.ToHtml(Content ?? "");

    // Fires every time the parameters (like Url) change
    protected override async Task OnParametersSetAsync()
    {
        // Only fetch if the URL has actually changed
        if (!string.IsNullOrEmpty(Url) && Url != _lastUrl)
        {
            _lastUrl = Url;
            Content = null; // Clear old content to show the spinner

            try
            {
                var urlWithCacheBuster = $"{Url}?v={DateTime.Now.Ticks}";
                Content = await Http.GetStringAsync(urlWithCacheBuster);
            }
            catch (Exception ex)
            {
                Content = $"# Error\nCould not load content from URL.\n\n_{ex.Message}_";
            }
        }
    }
}