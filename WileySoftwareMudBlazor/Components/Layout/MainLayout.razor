@inherits LayoutComponentBase
@inject IJSRuntime JSRuntime
@using WileySoftwareMudBlazor.Components.Layout

<MudThemeProvider Theme="_theme" @bind-IsDarkMode="_isDarkMode" />
<MudLayout>
    <MudAppBar Elevation="5">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="DrawerToggle" />
        <MudAvatar>
            <MudImage Src="Images/ChrisWiley.jpg" />
        </MudAvatar>

        <MudHidden Breakpoint="Breakpoint.Xs" Down="true">
            <MudText Typo="Typo.h5" Class="ml-3">Chris Wiley - Junior QA Analyst</MudText>
        </MudHidden>
        <MudHidden Breakpoint="Breakpoint.Sm" Up="true">
            <MudText Typo="Typo.h6" Class="ml-3">Chris Wiley</MudText>
        </MudHidden>

        <MudSpacer />

        @* --- NEW THEME TOGGLE BUTTON --- *@
        <MudIconButton Icon="@(_isDarkMode? Icons.Material.Filled.WbSunny : Icons.Material.Filled.NightsStay)" Color="Color.Inherit" OnClick="ToggleDarkModeAsync" />

        <MudIconButton Icon="@Icons.Custom.Brands.GitHub"
                       Color="Color.Inherit"
                       Edge="Edge.End"
                       Href="https://github.com/SithLord2K?tab=repositories"
                       Target="_blank" />

        <MudIconButton Icon="@Icons.Custom.Brands.LinkedIn"
                       Color="Color.Inherit"
                       Edge="Edge.End"
                       Href="https://www.linkedin.com/in/chris-wiley-007b9585/"
                       Target="_blank" />
    </MudAppBar>
    <MudDrawer id="nav-drawer" @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="2" Width="295px">
        <NavMenu />
    </MudDrawer>
    <MudMainContent Class="pt-16 pa-4" Style="margin-top: 25px; margin-bottom: 30px;">
        <MudPaper Elevation="2">
            @Body
        </MudPaper>
    </MudMainContent>
    <MudAppBar Bottom="true" Elevation="5" Dense="true">
        <MudSpacer />
        <MudText Typo="Typo.caption" Class="text-center">
            &copy; @DateTime.Now.Year WileySoftware
        </MudText>
        <MudDivider DividerType="DividerType.Inset" />
        &nbsp;
        <MudText Typo="Typo.caption" Align="Align.Center">Site created with Blazor, using C# and the</MudText>
        &nbsp
        <MudIcon Icon="@Icons.Custom.Brands.MudBlazor" />
        <MudText Typo="Typo.caption">udBlazor Compenent Library</MudText>
        <MudSpacer />
    </MudAppBar>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _drawerOpen = true;
    private bool _isDarkMode;
    private MudTheme _theme = new ProfessionalTheme();
    private const string CookieKey = "darkModePreference";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Try to read the cookie value
            var cookieValue = await JSRuntime.InvokeAsync<string>("getCookie", CookieKey);

            // If the cookie exists, set the theme. Otherwise, default to false (light mode).
            _isDarkMode = cookieValue == "true";

            StateHasChanged();
        }
    }

    private async Task ToggleDarkModeAsync()
    {
        _isDarkMode = !_isDarkMode;
        // Save the new preference to a cookie that lasts for 365 days
        await JSRuntime.InvokeVoidAsync("setCookie", CookieKey, _isDarkMode.ToString().ToLower(), 365);
    }

    private void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }
}