@using WileySoftwareMudBlazor.Services
@using WileySoftwareMudBlazor.Models
@inject ContentService ContentService

<MudNavMenu Style="margin-top: 25px">
    <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">Home</MudNavLink>

    @if (_navigationNodes == null)
    {
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Small" Class="ml-4" />
    }
    else
    {
        @foreach (var node in _navigationNodes)
        {
            @RenderNode(node)
        }
    }

    <MudNavGroup Title="Home Lab Setup" Icon="@Icons.Material.Filled.Computer" Expanded="false">
        <MudNavLink Href="/pentest-lab" Match="NavLinkMatch.Prefix" Icon="@Icons.Custom.Brands.Linux">External Pentest Practice</MudNavLink>
    </MudNavGroup>

    <MudNavLink Href="/aboutme" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Info">About Me</MudNavLink>
</MudNavMenu>

@code {
    private List<ContentNode>? _navigationNodes;

    protected override async Task OnInitializedAsync()
    {
        _navigationNodes = await ContentService.GetNavigationTreeAsync();
    }

    // Recursively renders a MudNavGroup or MudNavLink based on the ContentNode hierarchy.
    private RenderFragment RenderNode(ContentNode node) => __builder =>
    {
        if (node.IsGroup)
        {
            <MudNavGroup Title="@node.Title" Expanded="false" Icon="@node.Icon">
                @if (node.Items != null)
                {
                    @foreach (var child in node.Items)
                    {
                        @RenderNode(child)
                    }
                }
            </MudNavGroup>
        }
        else
        {
            var href = string.IsNullOrWhiteSpace(node.MarkdownFile)
                ? node.Route
                : $"/{node.Route}";

            <MudNavLink Href="@href" Match="NavLinkMatch.Prefix" Icon="@node.Icon">
                @node.Title
            </MudNavLink>
        }
    };
}